# Speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key

# LLM -- get this from Google AI Studio (aistudio.google.com), free API key.
# Check the model list in AI Studio for the current STABLE (non-preview) Flash
# or Flash-Lite model -- Google deprecates older Gemini versions fairly often,
# so don't assume the model name below is still current when you read this.
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-3.1-flash-lite

# Text-to-speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Optional speed settings (all have safe defaults; remove the # to use) ---
# LARA_PROMPT=full             # use the longer original prompt instead of the compact one
# FILLERS=off                  # turn off the spoken "one moment" while tools run
# LLM_PROVIDER=groq            # try Groq's faster Llama models instead of Gemini
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b      # names change: see console.groq.com/docs/models
# GROQ_REASONING_EFFORT=low           # how much a reasoning model thinks; 'omit' sends nothing
# LLM_PROVIDER=openai          # OpenAI, or any OpenAI-compatible service
# OPENAI_API_KEY=your_key
# OPENAI_MODEL=model_name_from_your_providers_list
# OPENAI_BASE_URL=https://api.cerebras.ai/v1   # leave out for OpenAI itself
# VAD=off                     # turn off voice activity detection (on by default)
# RED_FLAGS=off                # turn off the emergency safety net (on by default)
# GREETING=model                # let the language model write the greeting (slower); default is fixed text
# STALL_SECONDS=off             # holding phrase if the model is slow (default 5 seconds; off to disable)
# DEEPGRAM_LANGUAGE=en-IN       # speech recognition tuned for Indian English (Nova-3)
# DEEPGRAM_KEYTERMS=Lara,Riverside Surgery,Sid,Priya Sharma,Aisha Khan   # names to listen for (Nova-3)